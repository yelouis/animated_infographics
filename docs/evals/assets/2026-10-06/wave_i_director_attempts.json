     "text": "The librarian lives in Alder Creek"
    },
    {
     "i": 1,
     "word_start": 6,
     "word_end": 12,
     "start_ms": 1800,
     "end_ms": 3600,
     "text": "A padded envelope arrived from Portland"
    },
    {
     "i": 2,
     "word_start": 12,
     "word_end": 17,
     "start_ms": 3600,
     "end_ms": 5100,
     "text": "Inside was a hardcover novel"
    },
    {
     "i": 3,
     "word_start": 17,
     "word_end": 24,
     "start_ms": 5100,
     "end_ms": 7200,
     "text": "The book was due in March 1983"
    },
    {
     "i": 4,
     "word_start": 24,
     "word_end": 30,
     "start_ms": 7200,
     "end_ms": 9000,
     "text": "A stack of cash was included"
    },
    {
     "i": 5,
     "word_start": 30,
     "word_end": 36,
     "start_ms": 9000,
     "end_ms": 10800,
     "text": "The fine was ten cents daily"
    },
    {
     "i": 6,
     "word_start": 36,
     "word_end": 42,
     "start_ms": 10800,
     "end_ms": 12600,
     "text": "A note asked to help others"
    },
    {
     "i": 7,
     "word_start": 42,
     "word_end": 49,
     "start_ms": 12600,
     "end_ms": 14700,
     "text": "The cash was a confession or ransom"
    },
    {
     "i": 8,
     "word_start": 49,
     "word_end": 55,
     "start_ms": 14700,
     "end_ms": 16500,
     "text": "The name R. Okafor was listed"
    },
    {
     "i": 9,
     "word_start": 55,
     "word_end": 61,
     "start_ms": 16500,
     "end_ms": 18300,
     "text": "Two different handwritings filled the margins"
    },
    {
     "i": 10,
     "word_start": 61,
     "word_end": 68,
     "start_ms": 18300,
     "end_ms": 20400,
     "text": "R and J argued about the story"
    },
    {
     "i": 11,
     "word_start": 68,
     "word_end": 75,
     "start_ms": 20400,
     "end_ms": 22500,
     "text": "They used the library as a mailbox"
    },
    {
     "i": 12,
     "word_start": 75,
     "word_end": 80,
     "start_ms": 22500,
     "end_ms": 24000,
     "text": "J left a final question"
    },
    {
     "i": 13,
     "word_start": 80,
     "word_end": 87,
     "start_ms": 24000,
     "end_ms": 26100,
     "text": "R. Okafor never checked out books again"
    },
    {
     "i": 14,
     "word_start": 87,
     "word_end": 93,
     "start_ms": 26100,
     "end_ms": 27900,
     "text": "June Lind still visits the library"
    },
    {
     "i": 15,
     "word_start": 93,
     "word_end": 99,
     "start_ms": 27900,
     "end_ms": 29700,
     "text": "She lost her husband in 2015"
    },
    {
     "i": 16,
     "word_start": 99,
     "word_end": 105,
     "start_ms": 29700,
     "end_ms": 31500,
     "text": "Robert sent a message from Portland"
    },
    {
     "i": 17,
     "word_start": 105,
     "word_end": 110,
     "start_ms": 31500,
     "end_ms": 33000,
     "text": "His family moved in 1983"
    },
    {
     "i": 18,
     "word_start": 110,
     "word_end": 116,
     "start_ms": 33000,
     "end_ms": 34800,
     "text": "He kept the book 42 years"
    },
    {
     "i": 19,
     "word_start": 116,
     "word_end": 123,
     "start_ms": 34800,
     "end_ms": 36900,
     "text": "Robert and June met at the library"
    },
    {
     "i": 20,
     "word_start": 123,
     "word_end": 128,
     "start_ms": 36900,
     "end_ms": 38400,
     "text": "They now read books together"
    },
    {
     "i": 21,
     "word_start": 128,
     "word_end": 134,
     "start_ms": 38400,
     "end_ms": 40200,
     "text": "The money built a reading nook"
    }
